{
  "name": "@webship.co/workspace-kubernetes",
  "version": "1.0.2",
  "description": "Kubernetes for Webship Workspace: the K8S menu on every project with manifests (a k8s/ or kubernetes/ folder, a kustomization, or a Helm chart): apply, delete, pods, logs, a shell in a pod, describe, the current context. A runtime of @webship.co/workspace-container.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-kubernetes.git"
  },
  "files": [
    "dist/src",
    "features",
    "scripts",
    "README.md",
    "ddev",
    "host-mounts.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "kubernetes",
    "label": "Kubernetes",
    "typeActions": {
      "kubernetes": [
        "sites",
        "code"
      ]
    },
    "scripts": {
      "hostInstall": "scripts/host-install.sh"
    },
    "features": [
      "features/kubernetes.feature"
    ],
    "ddev": {
      "compose": [
        "ddev/docker-compose.kubernetes.yaml"
      ],
      "hostMounts": [
        "~/.kube"
      ]
    }
  },
  "dependencies": {
    "@webship.co/workspace-container": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.2",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
